<Window x:Class="NineLink.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NineLink — 9 Kings 联机" Width="640" Height="480"
        WindowStartupLocation="CenterScreen" Background="#1E1B18">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="NineLink" FontSize="26" FontWeight="Bold" Foreground="#F2C14E"/>
            <TextBlock x:Name="VersionText" FontSize="13" Foreground="#9A9182" VerticalAlignment="Bottom" Margin="10,0,0,5"/>
        </StackPanel>

        <!-- Shown when a newer GitHub release exists -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0" Padding="12,8"
                Background="#3A2E12" BorderBrush="#F2C14E" BorderThickness="1" CornerRadius="6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateLaterButton" Content="以后再说" Padding="10,4" Margin="0,0,8,0" Click="UpdateLater_Click"/>
                    <Button x:Name="UpdateButton" Content="立即更新" Padding="14,4" FontWeight="Bold" Click="Update_Click"/>
                </StackPanel>
                <TextBlock x:Name="UpdateText" Foreground="#F5E3B3" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,8,0,8">
            <TextBlock x:Name="GameText" Foreground="#E8E2D6" TextWrapping="Wrap"/>
            <TextBlock x:Name="BuildText" Foreground="#E8E2D6" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <TextBox x:Name="LogBox" Grid.Row="3" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 Background="#14110F" Foreground="#CFC8BA" BorderBrush="#3A332C"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OpenLogButton" Content="打开日志文件夹" Padding="14,6" Margin="0,0,8,0" Click="OpenLog_Click"/>
            <Button x:Name="LaunchButton" Content="启动游戏" Padding="22,6" FontWeight="Bold" Click="Launch_Click"/>
        </StackPanel>
    </Grid>
</Window>
